@PACKAGE_INIT@

# Capabilities of the FastDeploy build that produced this package, so that
# consumers can tell which devices the library was built with instead of
# probing at runtime. WITH_WEBGPU mirrors fastdeploy/core/config.h: the WebGPU
# device is always compiled in and gated at runtime by
# Ort::GetAvailableProviders(), so it is a capability flag rather than a build
# switch (same as WITH_DIRECTML/WITH_COREML).
set(WITH_WEBGPU ON)

include("${CMAKE_CURRENT_LIST_DIR}/fastdeploy_ppocrTargets.cmake")

check_required_components(fastdeploy_ppocr)
